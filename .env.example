# Local development values only. These are not real credentials.
# Copy to .env (git-ignored) to override the defaults used by docker-compose.yml.

POSTGRES_USER=policy_rag
POSTGRES_PASSWORD=policy_rag_local_only
POSTGRES_DB=policy_rag

# Host port that PostgreSQL is published on (the API reaches it on the compose network).
POSTGRES_HOST_PORT=5433

# Embedding model and vector width. They must agree; the API checks this at startup.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Answer generation. "extractive" quotes retrieved text and needs no model or API key.
# To use a chat model instead, set LLM_PROVIDER=openai_compatible plus the three below.
LLM_PROVIDER=extractive
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=
# LLM_API_KEY=

# Minimum cosine similarity of the best chunk for /api/ask to answer instead of refusing.
EVIDENCE_MIN_SIMILARITY=0.55
