# Local development values only. These are not real credentials.
# Copy to .env (git-ignored) to override the defaults used by docker-compose.yml.
# Every value below is the application default, so leaving a line as-is changes nothing.

# --- PostgreSQL ---
POSTGRES_USER=policy_rag
POSTGRES_PASSWORD=policy_rag_local_only
POSTGRES_DB=policy_rag
# Host port PostgreSQL is published on (the API reaches it on the Compose network).
POSTGRES_HOST_PORT=5433

# --- Embeddings ---
# The model is downloaded into the image at build time, so rebuild after changing it.
# EMBEDDING_DIM must match the model's output width; the API checks it against the
# vector column at startup. A different width needs a new chunks table (see docs/OPERATIONS.md).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking (characters) ---
# Changing these makes `python -m scripts.ingest` re-chunk and re-embed existing documents.
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# --- Retrieval / HNSW ---
# M and EF_CONSTRUCTION apply when the index is created; EF_SEARCH applies per query.
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40
# "semantic" (pgvector only, default), "lexical" (PostgreSQL full-text only) or "hybrid"
# (both, fused with Reciprocal Rank Fusion). Callers can also pick a mode per /api/search request.
RETRIEVAL_MODE=semantic
RRF_K=60
# Candidates each retriever contributes to the fusion in hybrid mode.
HYBRID_CANDIDATES=30
# Deadline (seconds) for one MCP tool call (python -m app.mcp_server).
MCP_TOOL_TIMEOUT_S=30

# --- Authentication and document authorization ---
# AUTH_MODE=off is a LOCAL DEMO mode: no login, every caller can read every document.
# AUTH_MODE=jwt validates bearer tokens and limits every search, answer and MCP tool to what the
# token's roles (employee, underwriter, compliance, admin), tenant and departments allow.
# jwt mode needs AUTH_ISSUER, AUTH_AUDIENCE and exactly ONE key source:
#   AUTH_JWKS_URL    an OIDC provider's JWKS endpoint (RS256/ES256)  <- use this in a real deployment
#   AUTH_PUBLIC_KEY  a PEM public key (RS256/ES256)
#   AUTH_JWT_SECRET  a shared secret of 32+ characters (HS256, local demos only; never commit one)
AUTH_MODE=off
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_JWKS_URL=
# AUTH_PUBLIC_KEY=
# AUTH_JWT_SECRET=
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
AUTH_DEPARTMENT_CLAIM=department
AUTH_LEEWAY_S=30

# --- Observability (OpenTelemetry) ---
# Spans and metrics are created in-process. Prometheus text is served at /metrics.
# Nothing leaves the process unless an OTLP/HTTP endpoint is set.
TELEMETRY_ENABLED=true
METRICS_ENABLED=true
OTEL_SERVICE_NAME=policy-rag-platform
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Off by default: questions can be sensitive. When true, traces get a 120-character preview.
RECORD_QUERY_TEXT=false
# Structured logs go to stderr: "json" (default) or "text".
LOG_FORMAT=json
LOG_LEVEL=INFO
# Cross-encoder reranking of the retrieved candidates. Off by default. The model is
# downloaded into the image at build time, so rebuild after changing RERANK_MODEL.
RERANK_ENABLED=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Candidates handed to the cross-encoder (never the whole corpus).
RERANK_CANDIDATES=20

# --- Evidence gate / RAG ---
# Minimum cosine similarity of the best chunk for /api/ask to answer instead of refusing.
EVIDENCE_MIN_SIMILARITY=0.55
# Most chunks passed to the answer generator.
RAG_MAX_CONTEXT_CHUNKS=4

# --- Optional LLM generator ---
# "extractive" quotes retrieved sentences and needs no model or API key.
# For a chat model set LLM_PROVIDER=openai_compatible and the three values below.
# Inside Docker, "localhost" is the container; use e.g. http://host.docker.internal:11434/v1.
LLM_PROVIDER=extractive
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# --- Optional AWS Bedrock generator ---
# Set LLM_PROVIDER=bedrock and BEDROCK_MODEL_ID to use it. There is no default model: use one
# your AWS account can invoke. Credentials are NOT configured here; use the standard AWS
# chain (an AWS_PROFILE, environment credentials, or an IAM role). Never commit keys.
# BEDROCK_MODEL_ID=
# BEDROCK_REGION=
# BEDROCK_MAX_TOKENS=512
# BEDROCK_TEMPERATURE=0.0
# BEDROCK_TIMEOUT_S=30
# BEDROCK_MAX_RETRIES=2
