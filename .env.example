# Local development values only. These are not real credentials.
# Copy to .env (git-ignored) to override the defaults used by docker-compose.yml.

POSTGRES_USER=policy_rag
POSTGRES_PASSWORD=policy_rag_local_only
POSTGRES_DB=policy_rag

# Host port that PostgreSQL is published on (the API reaches it on the compose network).
POSTGRES_HOST_PORT=5433

# Embedding model and vector width. They must agree; the API checks this at startup.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
